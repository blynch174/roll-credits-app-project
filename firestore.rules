rules_version = '2';

// Roll Credits database rules. Paste this whole file into
// Firebase console → Firestore Database → Rules, then click Publish.
//
// Who can do what:
//   - Anyone with an account can read and write only their own saved data (users/{their uid}).
//   - Nobody can add admins from the app. Admins are added by hand in the Firebase console.
//   - Anyone can read published official festivals; only admins can publish them or see drafts.
//   - Anyone can send feedback; only admins can read it.
//   - Admins can see who uses the app (email, last opened, app version, device type, two counts).
//   - Anyone can read movie requests (they hold no personal info). Signed-in people can add one vote per movie;
//     only admins can approve, reject, or delete.
//   - Everything else is closed.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // One document per person: the app's saved data as text, plus when it was saved.
    match /users/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['state', 'clientUpdatedAt', 'updatedAt', 'email', 'device', 'appVersion'])
        && request.resource.data.state is string
        && request.resource.data.state.size() < 900000
        && request.resource.data.clientUpdatedAt is number;
    }

    // Admins. Document id = the admin's user ID. A person may check whether they're an admin. No app writes.
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    // Published official festivals (Halloween, Christmas, …). Anyone can read them, even without an account,
    // so every copy of the app gets updates. Only admins publish.
    match /official/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admins' unpublished edits to official festivals.
    match /drafts/{id} {
      allow read, write: if isAdmin();
    }

    // Beta feedback from Settings → Send Feedback. Anyone can send (signed in or not); only admins read it.
    match /feedback/{id} {
      function fb() {
        return request.resource.data;
      }
      // Optional short text fields: absent, or a string no longer than n.
      function shortText(k, n) {
        return !(k in fb()) || (fb()[k] is string && fb()[k].size() <= n);
      }
      // Signed out: no user id and no email. Signed in: your own id and the email you signed in with.
      // createdAt must be within a day of now (a clock that's a little off is fine).
      allow create: if fb().keys().hasOnly(['text', 'appVersion', 'platform', 'screen', 'theme', 'uid', 'email', 'status', 'createdAt'])
        && fb().keys().hasAll(['text', 'uid', 'email', 'status', 'createdAt'])
        && fb().text is string && fb().text.size() > 0 && fb().text.size() <= 2000
        && fb().status == 'new'
        && fb().createdAt is int
        && fb().createdAt > request.time.toMillis() - 86400000 && fb().createdAt < request.time.toMillis() + 86400000
        && shortText('appVersion', 20) && shortText('platform', 20) && shortText('screen', 20) && shortText('theme', 40)
        && ((fb().uid == null && fb().email == '')
          || (signedIn() && fb().uid == request.auth.uid && fb().email == request.auth.token.get('email', '')));
      allow read, update, delete: if isAdmin();
    }

    // Who uses the app, for Admin Tools → View Users: each person writes only their own; admins can read them all.
    match /presence/{uid} {
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'lastSeen', 'firstSeen', 'appVersion', 'platform', 'watched', 'festivals']);
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow delete: if signedIn() && (request.auth.uid == uid || isAdmin());
    }

    // Movies people want added to the catalog. Document id = the TMDB id. Each account votes once: the vote is
    // a voters/{uid} document written in the same batch as the new request (or as the count going up by one).
    match /requests/{tmdbId} {
      function voterPath() {
        return /databases/$(database)/documents/requests/$(tmdbId)/voters/$(request.auth.uid);
      }
      allow read: if true;
      allow create: if isAdmin() || (signedIn()
        && request.resource.data.keys().hasOnly(['tmdbId', 'title', 'year', 'posterPath', 'count', 'status', 'moods', 'firstAt', 'lastAt'])
        && request.resource.data.tmdbId == int(tmdbId)
        && request.resource.data.title is string && request.resource.data.title.size() <= 300
        && request.resource.data.count == 1
        && request.resource.data.status == 'pending'
        && request.resource.data.moods.size() == 0
        && !exists(voterPath()) && existsAfter(voterPath()));
      allow update: if isAdmin() || (signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count', 'lastAt'])
        && request.resource.data.count == resource.data.count + 1
        && !exists(voterPath()) && existsAfter(voterPath()));
      allow delete: if isAdmin();

      match /voters/{uid} {
        allow get: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['at'])
          && existsAfter(/databases/$(database)/documents/requests/$(tmdbId));
        allow list, update, delete: if false;
      }
    }
  }
}
