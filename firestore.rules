rules_version = '2';

// Roll Credits database rules. Paste this whole file into
// Firebase console → Firestore Database → Rules, then click Publish.
//
// Who can do what:
//   - Each person can read and write only their own saved data (users/{their uid}),
//     and only if they're an admin, or on the invite list with a confirmed email.
//   - Only admins can see or change the invite list.
//   - Nobody can add admins from the app. Admins are added by hand in the Firebase console.
//   - Anyone can read published official festivals; only admins can publish them or see drafts.
//   - Everything else is closed.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function isInvited() {
      return signedIn()
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/invites/$(myEmail()));
    }

    // One document per person: the app's saved data as text, plus when it was saved.
    match /users/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid && (isAdmin() || isInvited());
      allow create, update: if signedIn() && request.auth.uid == uid && (isAdmin() || isInvited())
        && request.resource.data.keys().hasOnly(['state', 'clientUpdatedAt', 'updatedAt', 'email', 'device', 'appVersion'])
        && request.resource.data.state is string
        && request.resource.data.state.size() < 900000
        && request.resource.data.clientUpdatedAt is number;
    }

    // Invite list. Document id = lowercase email. A person may check their own invite (so the app can say
    // "not on the list yet"); only admins can list, add, or remove.
    match /invites/{email} {
      allow get: if signedIn() && (isAdmin() || myEmail() == email);
      allow list, create, update, delete: if isAdmin();
    }

    // Admins. Document id = the admin's user ID. A person may check whether they're an admin. No app writes.
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    // Published official festivals (Halloween, Christmas, …). Anyone can read them, even without an account,
    // so every copy of the app gets updates. Only admins publish.
    match /official/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admins' unpublished edits to official festivals.
    match /drafts/{id} {
      allow read, write: if isAdmin();
    }
  }
}
